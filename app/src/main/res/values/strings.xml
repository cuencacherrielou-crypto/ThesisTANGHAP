    <!-- About Strings -->
    <string name="about_tanghap">About TANGHAP</string>
    <string name="app_version">Version 1.0.0</string>
    <string name="what_is_tanghap">What is TANGHAP?</string>
    <string name="tanghap_description">TANGHAP (Intelligent Inhaler Monitoring) works with a smart inhaler attachment to track your breathing rate, inhalation effort, inhaler use and coughs. An on-device AI model classifies cough sounds, and the app gives a preliminary, non-diagnostic assessment to help you and your doctor follow your respiratory condition over time.</string>
    <string name="key_features">Key Features</string>
    <string name="features_list">• Live breathing rate and inhalation pressure monitoring\n• On-device AI cough classification (dry, wet, persistent, severe, wheezing)\n• Preliminary assessment worded as a possibility, never a diagnosis\n• Matching over-the-counter medicine guidance (recommendation only)\n• Inhaler press tracking and dose reminders\n• Monitoring continues in the background\n• Time-stamped history, daily summaries and trends\n• Alerts, emergency contact and nearby hospitals\n• PDF report for your doctor</string>
    <string name="copyright">© 2026 TANGHAP Project Team\nDeveloped for Academic Research</string>

