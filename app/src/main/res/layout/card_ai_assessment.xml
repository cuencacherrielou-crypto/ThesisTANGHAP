<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#1AFFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#33FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bg_glass_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI-Assisted Preliminary Assessment"
            android:textColor="@color/accent_teal"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="true"/>

        <TextView
            android:id="@+id/tvAiFindings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Processing respiratory patterns..."
            android:textColor="@color/text_high_emphasis"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <!-- Possible condition, always worded as a possibility (never a diagnosis) -->
        <TextView
            android:id="@+id/tvPossibleCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/warning"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvAiObservations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Detecting breathing rate and cough frequency."
            android:textColor="@color/text_medium_emphasis"
            android:textSize="13sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#22FFFFFF"/>

        <LinearLayout
            android:id="@+id/layoutOtc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Guidance:"
                android:textColor="@color/primary_light"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvOtcRecommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/text_high_emphasis"
                android:textSize="13sp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNearbyHospitals"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Find Nearby Healthcare Facilities"
            android:textColor="@color/accent_teal"
            app:strokeColor="@color/accent_teal"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCallEmergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Call Emergency Contact"
            android:backgroundTint="@color/error"
            android:textColor="@android:color/white"
            android:visibility="gone"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Disclaimer: AI-assisted respiratory monitoring and preliminary assessment only. DOES NOT medically diagnose diseases. Consult a healthcare professional before medication intake."
            android:textColor="@color/text_low_emphasis"
            android:textSize="10sp"
            android:alpha="0.7"
            android:gravity="center"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
