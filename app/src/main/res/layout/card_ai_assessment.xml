<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#1AFFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#33FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bg_glass_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI-Assisted Preliminary Assessment"
            android:textColor="@color/accent_teal"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="true"/>

        <!-- What to do, readable at a glance (session results only) -->
        <LinearLayout
            android:id="@+id/layoutAiHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvAiHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvAiAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- Possible condition, always worded as a possibility (never a diagnosis) -->
        <TextView
            android:id="@+id/tvPossibleCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/warning"
            android:textSize="19sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <!-- Key numbers of the session (session results only) -->
        <LinearLayout
            android:id="@+id/layoutAiKeyFacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:visibility="gone">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvKeyCoughs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_high_emphasis" android:textSize="28sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coughs" android:textColor="@color/text_medium_emphasis" android:textSize="14sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvKeyWheezes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_high_emphasis" android:textSize="28sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wheezes" android:textColor="@color/text_medium_emphasis" android:textSize="14sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvKeyBreathing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/text_high_emphasis" android:textSize="28sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Breathing" android:textColor="@color/text_medium_emphasis" android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutOtc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Guidance"
                android:textColor="@color/accent_teal"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvOtcRecommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/text_high_emphasis"
                android:textSize="15sp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNearbyHospitals"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Find Nearby Healthcare Facilities"
            android:textColor="@color/accent_teal"
            app:strokeColor="@color/accent_teal"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCallEmergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Call Emergency Contact"
            android:backgroundTint="@color/error"
            android:textColor="@android:color/white"
            android:visibility="gone"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#22FFFFFF"/>

        <!-- Full assessment text: folded on the result screen, always shown during a live session -->
        <TextView
            android:id="@+id/btnAiDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="Show full details ▾"
            android:textColor="@color/accent_teal"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/layoutAiDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvAiFindings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Processing respiratory patterns..."
                android:textColor="@color/text_high_emphasis"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAiObservations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Detecting breathing rate and cough frequency."
                android:textColor="@color/text_medium_emphasis"
                android:textSize="15sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Disclaimer: AI-assisted respiratory monitoring and preliminary assessment only. DOES NOT medically diagnose diseases. Consult a healthcare professional before medication intake."
            android:textColor="@color/text_low_emphasis"
            android:textSize="12sp"
            android:gravity="center"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
