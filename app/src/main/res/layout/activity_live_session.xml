<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_main">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="TANGHAP AI Monitoring"
            app:titleTextColor="@color/text_high_emphasis"
            app:navigationIcon="@drawable/ic_back_white"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- AI-Assisted Assessment Card -->
            <include layout="@layout/card_ai_assessment"
                android:id="@+id/aiAssessmentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <!-- Real-time Breathing Metrics -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <!-- Breathing pattern from the breathing sounds: a label only, no numbers
                         (inhalation effort and breathing-rate values are hidden for now) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Breathing Pattern"
                        android:textColor="@color/text_medium_emphasis"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvBreathingPattern"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Listening to breathing..."
                            android:textColor="@color/text_high_emphasis"
                            android:textSize="22sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvLiveActuations"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 Actuations"
                            android:textColor="@color/secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBreathingHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Breathe normally toward the device."
                        android:textColor="@color/text_medium_emphasis"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cough Activity -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
                    <TextView android:id="@+id/labelCough" android:text="Cough Sound Level (microphone %)" android:textColor="@color/error" android:textStyle="bold" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <com.github.mikephil.charting.charts.BarChart android:id="@+id/chartCough" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/labelCough" android:layout_marginTop="4dp"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEndSession"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="End &amp; Save Session"
                android:backgroundTint="@color/error"
                app:cornerRadius="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
