<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_main"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Session AI Analysis"
            app:titleTextColor="@color/text_high_emphasis"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/text_high_emphasis"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- AI Assessment Card -->
            <include layout="@layout/card_ai_assessment"
                android:id="@+id/aiAssessmentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <!-- Baseline Comparison Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Baseline Comparison"
                        android:textColor="@color/accent_teal"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"/>
                    <TextView
                        android:id="@+id/tvBaselineComparison"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Computing baseline..."
                        android:textColor="@color/text_high_emphasis"
                        android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detailed Metrics Grid -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Session Summary"
                        android:textColor="@color/secondary"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/divider"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="3">

                        <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:orientation="vertical" android:layout_marginBottom="24dp">
                            <TextView android:text="Avg. Resp Rate" android:textSize="11sp" android:textColor="@color/text_low_emphasis" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tvAvgBpm" android:text="-- BPM" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_high_emphasis" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:orientation="vertical" android:layout_marginBottom="24dp">
                            <TextView android:text="Peak Effort" android:textSize="11sp" android:textColor="@color/text_low_emphasis" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tvPeak" android:text="-- kPa" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_high_emphasis" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:orientation="vertical" android:layout_marginBottom="24dp">
                            <TextView android:text="Cough Events" android:textSize="11sp" android:textColor="@color/text_low_emphasis" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tvCough" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_high_emphasis" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:orientation="vertical" android:layout_marginBottom="24dp">
                            <TextView android:text="Actuations" android:textSize="11sp" android:textColor="@color/text_low_emphasis" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tvAct" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_high_emphasis" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:orientation="vertical">
                            <TextView android:text="Inhale Dur." android:textSize="11sp" android:textColor="@color/text_low_emphasis" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tvInhaleDur" android:text="-- s" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_high_emphasis" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Representative Pattern Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:text="Recorded Pressure Trace (seconds into session)" android:textColor="@color/text_low_emphasis" android:textStyle="bold" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <com.github.mikephil.charting.charts.LineChart android:id="@+id/chartResultPattern" android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Time-stamped Session Timeline -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:text="Session Timeline" android:textColor="@color/accent_teal" android:textStyle="bold" android:textSize="12sp" android:textAllCaps="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/tvTimelineSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_high_emphasis"
                        android:textSize="13sp"/>
                    <TextView android:id="@+id/tvBpmTimelineLabel" android:text="Breathing Rate Over Time (BPM)" android:textColor="@color/text_low_emphasis" android:textStyle="bold" android:textSize="11sp" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <com.github.mikephil.charting.charts.LineChart android:id="@+id/chartBpmTimeline" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="8dp"/>
                    <TextView
                        android:id="@+id/tvCoughReviewHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Was a cough from someone near you? Tap Not mine to remove it, or Count it to add back a cough that was left out. The results update automatically."
                        android:textColor="@color/text_low_emphasis"
                        android:textSize="11sp"
                        android:visibility="gone"/>
                    <!-- One row per key event; cough rows get a Not mine / Count it button -->
                    <LinearLayout
                        android:id="@+id/timelineContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- EXPORT BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Export PDF for Doctor"
                android:textStyle="bold"
                android:backgroundTint="@color/accent_teal"
                android:textColor="@color/primary_dark"
                app:icon="@android:drawable/ic_menu_save"
                app:iconTint="@color/primary_dark"
                app:cornerRadius="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoDashboard"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="32dp"
                android:text="Return to Dashboard"
                android:textColor="@color/text_medium_emphasis"
                app:cornerRadius="20dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
